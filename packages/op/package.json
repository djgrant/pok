{
  "name": "@pokit/op",
  "version": "1.0.2-dev.0",
  "description": "Operation utilities for pok CLI applications",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "bun",
    "terminal",
    "pok",
    "pokjs",
    "operations",
    "utilities",
    "helpers"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djgrant/pok.git",
    "directory": "packages/op"
  },
  "homepage": "https://github.com/djgrant/pok#readme",
  "bugs": {
    "url": "https://github.com/djgrant/pok/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node ../core/scripts/fix-dist-imports.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pokit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
