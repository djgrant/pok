{
  "name": "pokit",
  "version": "0.4.0",
  "description": "Global CLI launcher for pok - install once, run anywhere",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djgrant/pok.git",
    "directory": "packages/cmd"
  },
  "homepage": "https://github.com/djgrant/pok#readme",
  "bugs": {
    "url": "https://github.com/djgrant/pok/issues"
  },
  "bin": {
    "pok": "./bin/pok.ts",
    "poks": "./bin/poks.ts"
  },
  "exports": {
    ".": {
      "types": "./src/protocol.ts",
      "import": "./bin/pok.ts"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@pokit/core": "workspace:*",
    "@pokit/terminal": "workspace:*"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "cli",
    "pok",
    "pokit"
  ]
}
