{
  "name": "@pokit/core",
  "version": "0.0.9",
  "description": "Core framework for building CLI applications with pok",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "bun",
    "terminal",
    "pok",
    "pokjs",
    "cli-framework",
    "command-routing",
    "file-based-routing"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notation-dev/openpok.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/notation-dev/openpok#readme",
  "bugs": {
    "url": "https://github.com/notation-dev/openpok/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pokit/config": "workspace:*",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@pokit/reporter-clack": "workspace:*",
    "@pokit/prompter-clack": "workspace:*",
    "@pokit/test-utils": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
