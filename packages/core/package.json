{
  "name": "@pokit/core",
  "version": "0.8.0",
  "description": "Core framework for building CLI applications with pok",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "bun",
    "terminal",
    "pok",
    "pokjs",
    "cli-framework",
    "command-routing",
    "file-based-routing"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notation-dev/openpok.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/notation-dev/openpok#readme",
  "bugs": {
    "url": "https://github.com/notation-dev/openpok/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node scripts/fix-dist-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@folder/xdg": "^4.0.1",
    "fast-glob": "^3.3.2",
    "picomatch": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/picomatch": "^3.0.1",
    "@pokit/test-utils": "workspace:*",
    "pokit": "workspace:*"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
