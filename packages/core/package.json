{
  "name": "@pokit/core",
  "version": "1.0.1-dev.0",
  "description": "Core framework for building CLI applications with pok",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "bun",
    "terminal",
    "pok",
    "pokjs",
    "cli-framework",
    "command-routing",
    "file-based-routing",
    "standard-schema"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djgrant/pok.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/djgrant/pok#readme",
  "bugs": {
    "url": "https://github.com/djgrant/pok/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node scripts/fix-dist-imports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/picomatch": "^3.0.1",
    "@pokit/test-utils": "workspace:*",
    "pokit": "workspace:*",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.17.0"
  }
}
