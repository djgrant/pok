{
  "name": "@openpok/introspect",
  "version": "0.0.1",
  "description": "Live file viewer TUI for pok commands directory",
  "keywords": [
    "cli",
    "tui",
    "file-viewer",
    "terminal",
    "pok"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notation-dev/openpok.git",
    "directory": "packages/introspect"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openpok/core": "workspace:*",
    "cli-highlight": "^2.1.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  }
}
