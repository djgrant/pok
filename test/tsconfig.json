{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@pokit/core": ["../packages/core/src/index.ts"],
      "@pokit/op": ["../packages/op/src/index.ts"],
      "@pokit/prompter-clack": ["../packages/prompter-clack/src/index.ts"],
      "@pokit/reporter-clack": ["../packages/reporter-clack/src/index.ts"],
      "@pokit/reporter-web": ["../packages/reporter-web/src/index.ts"],
      "@pokit/tabs-core": ["../packages/tabs-core/src/index.ts"],
      "@pokit/opentui": ["../packages/opentui/src/index.ts"],
      "@pokit/test-utils": ["./utils/src/index.ts"]
    }
  },
  "include": [
    "core/**/*",
    "reporter-clack/**/*",
    "prompter-clack/**/*",
    "op/**/*",
    "tabs-core/**/*",
    "opentui/**/*",
    "cases/**/*",
    "commands/**/*",
    "shared/**/*"
  ],
  "exclude": ["utils/**/*"],
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/reporter-clack" },
    { "path": "../packages/prompter-clack" },
    { "path": "../packages/op" },
    { "path": "../packages/tabs-core" },
    { "path": "../packages/opentui" },
    { "path": "./utils" }
  ]
}
